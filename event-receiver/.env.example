# Copy to .env and adjust for your environment. Loaded automatically by app.py.

# Standard OTel exporter env vars, read directly by OTLPLogExporter().
# Points at the medlog-otelcol service on the compose network; if running this app
# outside Docker instead, use localhost:4318 (requires publishing medlog-otelcol's ports).
OTEL_EXPORTER_OTLP_ENDPOINT=http://medlog-otelcol:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<token>

# Required API key for event ingestion.
MEDLOG_API_KEY=change-me

# Flask server port.
PORT=5000
